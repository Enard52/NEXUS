export function renderDownloadCenter(releases: VersionInfoService, userAgent: string, _surface?: string): string {
  const isTr = CURRENT_LOCALE === "tr";
  const all = releases.all();
  const featured = releases.featuredFor(userAgent);
  const featureHtml = featured
    ? `<a class="dl-primary" href="${escapeHtml(featured.downloadUrl)}">${isTr ? "İndir" : "Download for"} ${featured.platform === "windows" ? "Windows" : featured.platform === "macos" ? "macOS" : featured.platform === "linux" ? "Linux" : featured.platform.toUpperCase()} &mdash; v${escapeHtml(featured.version)}</a>`
    : `<p>${isTr ? "Platformunuzu seçin" : "Choose your platform"}</p>`;

  const rows = all.map((r) =>
    `<tr><td>${escapeHtml(r.platform === "windows" ? "Windows" : r.platform === "macos" ? "macOS" : r.platform === "linux" ? "Linux" : r.platform.toUpperCase())}</td><td>${escapeHtml(r.version)}</td><td>${escapeHtml(r.minOs)}</td><td><code>${escapeHtml(r.checksumSha256)}</code></td></tr>`
  ).join("");

  return `<h2>${isTr ? "İndirme" : "Download"}</h2>${featureHtml}<table><thead><tr><th>${isTr ? "Platform" : "Platform"}</th><th>${isTr ? "Sürüm" : "Version"}</th><th>${isTr ? "Minimum OS" : "Minimum OS"}</th><th>SHA-256 ${isTr ? "Sağlama" : "Checksum"}</th></tr></thead><tbody>${rows}</tbody></table>`;
}


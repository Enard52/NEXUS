.bento-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
.bento-grid.wide { grid-template-columns: 1fr; }
.bento-tile { background: var(--surface); border-radius: var(--radius); padding: 1.5rem; border: 1px solid var(--border); }
.bento-tile.featured { grid-column: span 2; }
.bento-tile.wide { grid-column: 1 / -1; }
.cardicon { display: inline-block; margin-right: 0.5rem; }
.ring { width: 60px; height: 60px; }
.assistant-strip { display: flex; align-items: center; gap: 1rem; padding: 1rem; background: var(--surface); border-radius: var(--radius); margin-top: 1rem; }
.nudge { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--primary); margin-left: 0.5rem; }
.room-card { background: var(--surface); border-radius: var(--radius); padding: 1rem; border: 1px solid var(--border); display: flex; align-items: center; gap: 1rem; }
.device-pill { display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem; background: var(--surface); border-radius: var(--radius); border: 1px solid var(--border); }
.dot { width: 8px; height: 8px; border-radius: 50%; }
.dot.on { background: #4caf50; }
.dot.off { background: #f44336; }
.suggest-card { background: var(--surface); border-radius: var(--radius); padding: 1rem; border: 1px solid var(--border); }
.skill-bar-wrap { background: var(--surface); border-radius: var(--radius); padding: 1rem; border: 1px solid var(--border); }
.member-card { background: var(--surface); border-radius: var(--radius); padding: 1rem; border: 1px solid var(--border); display: flex; align-items: center; gap: 1rem; }
.plan-card { background: var(--surface); border-radius: var(--radius); padding: 1.5rem; border: 1px solid var(--border); }
.field-row { display: flex; align-items: center; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--border); }
.features { padding: 4rem 0; }
.feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
.feature-card { text-align: center; padding: 2rem; }
.feature-card h3 { margin-bottom: 0.5rem; }
.faq { padding: 4rem 0; }
.faq details { margin-bottom: 1rem; padding: 1rem; background: var(--surface); border-radius: var(--radius); }
.faq summary { font-weight: 600; cursor: pointer; }
.site-footer { padding: 2rem; text-align: center; border-top: 1px solid var(--border); color: var(--muted); }
.meta { color: var(--muted); font-size: 12px; }
.actions { display: flex; gap: 8px; }
.avatar { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: var(--tint); color: var(--primary); font-weight: 700; }
.dl-primary { display: inline-block; background: var(--primary); color: #fff; padding: 16px 32px; border-radius: var(--radius); font-weight: 600; text-decoration: none; margin-bottom: 16px; }
table { width: 100%; border-collapse: collapse; font-size: 12px; }
th, td { text-align: left; padding: 12px; border-bottom: 1px solid var(--border); }
th { color: var(--muted); font-weight: 600; }
code { color: var(--muted); word-break: break-all; }
.web-nav { display: flex; align-items: center; justify-content: center; gap: 6px; flex-wrap: wrap; }
.web-nav a { padding: 0.5rem 1rem; border-radius: var(--radius); white-space: nowrap; color: var(--primary); }
.web-nav a.active { background: var(--primary); color: var(--on-primary); }
.lede { max-width: 640px; margin: 0 auto 2rem; color: var(--muted); font-size: 1.15rem; }
.hero .actions { justify-content: center; }
.trust { color: var(--muted); font-size: 14px; margin-top: 1rem; }
.navbar { width: 100%; }
.nav-container { display: flex; align-items: center; justify-content: space-between; width: 100%; }
.nav-brand-group { display: inline-flex; align-items: center; }
.nav-brand { display: inline-flex; align-items: center; gap: 8px; color: var(--text); }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; display: flex; flex-direction: column; gap: 6px; box-shadow: var(--elev); }
.card .cardicon, .dev-icon { color: var(--primary); }
.value { font-weight: 600; }
.card .value, .bento-tile .value { font-size: 1.6rem; font-weight: 700; }
.label { color: var(--muted); font-size: 13px; }
.tile-head { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; color: var(--muted); }
.tile-title { font-size: 13px; font-weight: 600; }
.ring-wrap { display: flex; align-items: center; gap: 12px; }
.ring-meta { display: flex; flex-direction: column; }
.who { font-weight: 700; }
.msg { color: var(--muted); }
.room-info { display: flex; flex-direction: column; }
.dev-info { display: flex; flex-direction: column; flex: 1; }
.dev-name { font-weight: 600; }
.dev-room { color: var(--muted); font-size: 12px; }
.skill-bar-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-weight: 600; }
.count { color: var(--muted); font-weight: 600; }
.skill-bar-track { height: 8px; background: var(--tint-soft); border-radius: 999px; overflow: hidden; }
.skill-bar-fill { height: 100%; background: var(--primary); border-radius: 999px; }
.price { font-size: 2rem; font-weight: 800; }
.price span { font-size: 1rem; font-weight: 500; color: var(--muted); }
.feature-card .icon { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--tint); color: var(--primary); margin-bottom: 1rem; }
.feature-card p { color: var(--muted); }
.btn { cursor: pointer; }
.btn.primary { background: var(--primary); color: var(--on-primary); }
.actions .btn:not(.primary), .assistant-strip .btn { background: var(--surface); border: 1px solid var(--border); color: var(--text); }
.faq-section { padding: 4rem 0; }
.faq-grid { display: flex; flex-direction: column; gap: 12px; }
.faq-item { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; }
.faq-q { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-weight: 600; cursor: pointer; list-style: none; }
.faq-q::-webkit-details-marker { display: none; }
.faq-icon { color: var(--primary); font-size: 1.25rem; }
.faq-item[open] .faq-icon { transform: rotate(45deg); }
.faq-a { color: var(--muted); margin-top: 12px; }
@media (max-width: 768px) {
  .hero h1 { font-size: 2rem; }
  .bento-tile.featured { grid-column: span 1; }
  nav { flex-wrap: nowrap; }
}`;
}

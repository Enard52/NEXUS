{
  "name": "nexus-desktop-app",
  "version": "3.14.2",
  "description": "NEXUS AI — real desktop application: tray + background, loads the synced app.",
  "main": "main.cjs",
  "author": "NEXUS Technologies Inc.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "gen:icon": "node gen-tray-icon.cjs",
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.nexus.desktop",
    "productName": "NEXUS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "NEXUS-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "NEXUS-${version}.dmg"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "NEXUS Technologies Inc.",
      "artifactName": "NEXUS-${version}.${ext}"
    }
  }
}

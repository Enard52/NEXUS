{
  "name": "nexus-desktop-app",
  "version": "3.14.2",
  "description": "NEXUS AI — real desktop application (Electron): tray + background, loads the synced app.",
  "main": "main.cjs",
  "author": "NEXUS Technologies Inc.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "gen:icon": "node gen-tray-icon.cjs",
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.nexus.desktop",
    "productName": "NEXUS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "NEXUS-${version}.exe"
    }
  }
}

{
  "name": "nexus-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NEXUS AI — Personal Operating System (monorepo root).",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "pnpm --filter @nexus/server dev",
    "start": "pnpm build:static && pnpm --filter @nexus/server start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check packages",
    "scaffold:modules": "node scripts/scaffold-modules.mjs",
    "site:shots": "node scripts/site-shots.mjs",
    "site:icons": "node scripts/site-icons.mjs",
    "site:build": "node scripts/site-build.mjs",
    "site:full": "node scripts/site-shots.mjs && node scripts/site-build.mjs && node scripts/verify-site.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:site:smoke": "node scripts/verify-site.mjs --smoke",
    "build:static": "pnpm --filter @nexus/web build:site && node scripts/fix-review-avatars.mjs && node scripts/copy-static.mjs",
    "build:client": "pnpm --filter @nexus/client build",
    "build:server": "pnpm --filter @nexus/server build",
    "build": "pnpm build:static && pnpm build:client && pnpm build:server",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:mobile": "node scripts/publish-mobile-artifact.mjs",
    "publish:web": "node scripts/publish-web-local.mjs",
    "publish:site": "node scripts/publish-site-local.mjs",
    "changelog": "echo See CHANGELOG.md",
    "build:tailwind": "tailwindcss -i src/input.css -o www/css/tailwind.css --minify",
    "build:tailwind:watch": "tailwindcss -i src/input.css -o www/css/tailwind.css --minify --watch",
    "copy:fonts": "xcopy /Y node_modules\\@fontsource\\inter\\files\\inter-latin-*.woff2 www\\fonts\\inter\\ 2>nul",
    "copy:lucide": "xcopy /Y node_modules\\lucide\\dist\\umd\\lucide.js www\\js\\lucide.js 2>nul",
    "copy:leaflet": "node scripts/copy-leaflet.mjs",
    "build:assets": "npm run build:tailwind && npm run copy:fonts && npm run copy:lucide && npm run copy:leaflet",
    "sync:www": "node scripts/sync-www.mjs",
    "audit:ui": "node scripts/ui-audit.mjs",
    "audit:ui:summary": "node scripts/ui-audit-summary.mjs",
    "audit:i18n": "node scripts/i18n-sweep.mjs",
    "audit:i18n:coverage": "node scripts/i18n-coverage.mjs",
    "verify:notify": "node scripts/verify-notify.mjs",
    "verify:cloud": "node node_modules/vitest/vitest.mjs run packages/web/src/cloud-sync.test.ts packages/web/src/notify.test.ts",
    "audit:all": "npm run typecheck && npm test && npm run audit:i18n && npm run audit:i18n:coverage && npm run audit:ui && npm run audit:ui:summary && npm run verify:site:smoke",
    "build:full": "npm run build:assets && npm run sync:www"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^24.0.0",
    "autoprefixer": "^10.4.20",
    "leaflet": "1.9.4",
    "playwright": "^1.61.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.4",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "esbuild": "^0.24.2",
    "lucide": "^0.447.0"
  },
  "author": "NEXUS",
  "license": "SEE LICENSE IN LICENSE"
}

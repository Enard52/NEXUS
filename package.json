{
  "name": "nexus-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NEXUS AI — Personal Operating System (monorepo root).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @nexus/core dev",
    "start": "pnpm --filter @nexus/core start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scaffold:modules": "node scripts/scaffold-modules.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

{
  "name": "nexus-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NEXUS AI — Personal Operating System (monorepo root).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "pnpm --filter @nexus/server dev",
    "start": "pnpm build:static && pnpm --filter @nexus/server start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "scaffold:modules": "node scripts/scaffold-modules.mjs",
    "build:static": "pnpm --filter @nexus/web build:demo && pnpm --filter @nexus/mobile build:demo && pnpm --filter @nexus/desktop build:demo && node scripts/copy-static.mjs",
    "build:desktop": "cd desktop-app && npm install && npm run build:win"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0"
  }
}

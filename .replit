modules = ["web", "dotnet-7.0", "nodejs-22"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm start"
waitForPort = 4178

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 4178
externalPort = 80

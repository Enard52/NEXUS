{
  "name": "nexus-setup-installer",
  "version": "3.14.2",
  "description": "NEXUS AI — real, runnable setup wizard.",
  "main": "main.js",
  "author": "NEXUS Technologies Inc.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.nexus.setup",
    "productName": "NEXUS Setup",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "wizard.html",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../desktop-app/dist",
        "to": "payload",
        "filter": [
          "NEXUS-*.exe",
          "NEXUS-*.AppImage",
          "!*.blockmap"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "NEXUS-Setup-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "NEXUS-Setup-${version}.dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "NEXUS Technologies Inc.",
      "artifactName": "NEXUS-Setup-${version}.${ext}"
    }
  }
}

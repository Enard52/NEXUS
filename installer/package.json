{
  "name": "nexus-setup-installer",
  "version": "3.14.2",
  "description": "NEXUS AI — real, runnable Windows setup wizard (Electron)",
  "main": "main.js",
  "author": "NEXUS Technologies Inc.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.nexus.setup",
    "productName": "NEXUS Setup",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "wizard.html",
      "assets/**"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "NEXUS-Setup-${version}.exe"
    }
  }
}

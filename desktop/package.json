{
  "name": "nexus-desktop",
  "productName": "NEXUS",
  "version": "1.0.38",
  "description": "NEXUS — akıllı ev asistanı (masaüstü)",
  "homepage": "https://nexus-smarthome.pages.dev",
  "main": "main.cjs",
  "author": {
    "name": "NEXUS",
    "email": "nexus.smarthome.app@gmail.com"
  },
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare-app.cjs",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder",
    "dist:win": "npm run prepare-app && electron-builder --win",
    "dist:store": "npm run prepare-app && electron-builder --win appx --x64",
    "dist:linux": "npm run prepare-app && electron-builder --linux"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "electron-updater": "6.8.9",
    "hap-nodejs": "^0.14.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@<11.0.1": ">=11.0.1",
    "glob@>=9.0.0": ">=14.0.2"
  },
  "build": {
    "appId": "app.nexus.desktop",
    "productName": "NEXUS",
    "copyright": "© 2026 NEXUS",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "ssdp.cjs",
      "auth-preload.cjs",
      "kit/**/*",
      "resources/**/*",
      "app/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "resources/icons/**/*",
      "resources/icon.png",
      "resources/icon.ico"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Enard52",
        "repo": "nexus-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "NEXUS-Setup.${ext}",
      "legalTrademarks": "NEXUS"
    },
    "appx": {
      "identityName": "NEXUSSmartHome.NEXUSSmartHome",
      "publisher": "CN=3FCF4ADE-FCBF-4742-B776-3BD63131E17F",
      "publisherDisplayName": "NEXUS Smart Home",
      "displayName": "NEXUS Smart Home",
      "applicationId": "NEXUS",
      "backgroundColor": "transparent",
      "languages": [
        "en-US",
        "tr-TR"
      ],
      "artifactName": "NEXUS-Store.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEXUS",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "uninstallDisplayName": "NEXUS",
      "installerSidebar": "resources/installerSidebar.bmp",
      "uninstallerSidebar": "resources/installerSidebar.bmp",
      "installerHeader": "resources/installerHeader.bmp",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "displayLanguageSelector": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "resources/icon-mac.png",
      "category": "public.app-category.lifestyle",
      "artifactName": "NEXUS-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "NEXUS",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "background": "resources/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Utility",
      "synopsis": "Akıllı ev asistanı",
      "maintainer": "NEXUS <nexus.smarthome.app@gmail.com>",
      "artifactName": "NEXUS-linux.${ext}",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "NEXUS-linux.${ext}"
    },
    "deb": {
      "artifactName": "NEXUS-linux.${ext}"
    },
    "rpm": {
      "artifactName": "NEXUS-linux.${ext}"
    }
  },
  "desktopName": "nexus.desktop"
}

# ─────────────────────────────────────────────────────────────
# NEXUS AI — Environment configuration (FAZ 0)
# Copy this file to `.env` and fill in real values.
# Secrets (API keys, tokens) must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# Runtime environment: development | test | production
NODE_ENV=development

# Structured log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Human-readable service identity used in logs
NEXUS_SERVICE_NAME=nexus-core

# Core service heartbeat interval in milliseconds (0 disables the heartbeat)
NEXUS_HEARTBEAT_MS=15000

# ── AI provider (FAZ 1 wires this into the AI Adapter) ──
# Provider selected in FAZ 0 planning: openai
AI_PROVIDER=openai
# Leave empty in FAZ 0; required once the AI Adapter is implemented (FAZ 1).
OPENAI_API_KEY=

# ── Social / federated sign-in (Section H) ──
# Public base URL used to build OAuth callback URIs. Defaults to
# http://localhost:${PORT}. In production this MUST be your HTTPS origin, and
# each redirect URI below must be registered with the provider console.
#   Google -> ${OAUTH_BASE_URL}/api/oauth/google/callback
#   Apple  -> ${OAUTH_BASE_URL}/api/oauth/apple/callback
OAUTH_BASE_URL=

# Google OIDC (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (https://developer.apple.com — Services ID + Key .p8).
# APPLE_CLIENT_ID is the Services ID; the private key may use literal \n escapes.
# NOTE: Apple's callback is a cross-site POST (form_post); it only reaches the
# server when the app is served over HTTPS (SameSite=None cookies).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

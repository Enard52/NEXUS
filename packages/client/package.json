{
  "name": "@nexus/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NEXUS AI — Real React application shared by web /app, the desktop shell and the mobile app.",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/app/",
    "build:mobile": "vite build --base=./ --outDir dist-mobile --mode mobile",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nexus/design-system": "workspace:*",
    "@nexus/i18n": "workspace:*",
    "@nexus/interface": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.4.4"
  },
  "author": "NEXUS",
  "license": "SEE LICENSE IN LICENSE"
}
